# Speech-to-text: https://console.deepgram.com (free credit on sign-up)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general

# LLM: https://console.groq.com (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high for gpt-oss models; leave empty for non-reasoning models
GROQ_REASONING_EFFORT=low

# Text-to-speech: https://play.cartesia.ai (free tier)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# Turn-taking (seconds). See README for why these values.
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
VAD_CONFIDENCE=0.7
SMART_TURN_STOP_SECS=3.0
USER_TURN_STOP_TIMEOUT=3.0
